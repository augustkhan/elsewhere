<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ELSEWHERE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Spectral:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root{--paper:#ece3cf;--paper2:#f3ecda;--ink:#1c1b19;--mute:#5c5a53;--gray:#a8a69e;--line:#1c1b19;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--paper:#171614;--paper2:#201f1c;--ink:#ece3cf;--mute:#a8a69e;--gray:#4a4944;--line:#ece3cf;color-scheme:dark}}
:root[data-theme="dark"]{--paper:#171614;--paper2:#201f1c;--ink:#ece3cf;--mute:#a8a69e;--gray:#4a4944;--line:#ece3cf;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:19px/1.6 Spectral,Georgia,serif}
.wrap{max-width:1040px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:Anton,Impact,'Arial Black',sans-serif;font-weight:400;margin:0;line-height:.95;text-transform:uppercase}
.hero{border-bottom:3px solid var(--line);padding:56px 0 40px;overflow:hidden}
.hero h1{font-size:clamp(56px,15.5vw,170px);letter-spacing:.01em}
.hero .row{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;align-items:end;margin-top:28px}
.tag{font-size:clamp(24px,3.4vw,38px);line-height:1.2;font-style:italic;margin:0}
.hero p.s{margin:14px 0 0;color:var(--mute);max-width:46ch}
.door{width:100%;height:auto;display:block}
.btn{display:inline-block;margin-top:22px;background:var(--ink);color:var(--paper);padding:14px 26px;font:400 22px Anton,Impact,sans-serif;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;border:2px solid var(--ink)}
.btn:hover{background:var(--paper);color:var(--ink)}
.btn:focus-visible,a:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
section{padding:64px 0;border-bottom:1px solid var(--line)}
h2{font-size:clamp(40px,7vw,76px);margin-bottom:28px}
.mission{font-size:clamp(22px,3vw,30px);line-height:1.4;max-width:30em}
.rules{list-style:none;margin:0;padding:0}
.rules li{font:400 clamp(26px,4.6vw,48px)/1.1 Anton,Impact,sans-serif;text-transform:uppercase;padding:16px 0;border-top:1px solid var(--line)}
.rules li span{display:block;font:400 17px/1.5 Spectral,Georgia,serif;text-transform:none;color:var(--mute);margin-top:6px;max-width:52ch}
.fm{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:8px 40px;padding:20px 0;border-top:1px solid var(--line)}
.fm h3{font-size:clamp(26px,3.4vw,38px)}
.fm .when{font-style:italic;color:var(--mute);font-size:16px;margin-top:6px;display:block;font-family:Spectral,serif;text-transform:none}
.fm p{margin:0}
.crew{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:2px solid var(--line)}
.crew div{padding:22px 20px 26px;border:1px solid var(--line);min-height:190px}
.crew div:nth-child(2n){background:var(--ink);color:var(--paper)}
.crew div:nth-child(2n) small{color:var(--gray)}
.crew h3{font-size:34px;margin-bottom:10px}
.crew small{display:block;font-size:16px;line-height:1.45;color:var(--mute)}
.note{margin-top:18px;color:var(--mute);font-style:italic}
.steps{list-style:none;margin:0;padding:0;counter-reset:s}
.steps li{counter-increment:s;display:grid;grid-template-columns:72px 1fr;gap:12px;padding:18px 0;border-top:1px solid var(--line)}
.steps li:before{content:counter(s);font:400 56px/1 Anton,Impact,sans-serif;color:var(--gray)}
.steps b{font:400 26px/1.1 Anton,Impact,sans-serif;text-transform:uppercase;display:block;margin-bottom:4px}
.join{background:var(--ink);color:var(--paper);border-bottom:0;padding:80px 0}
.join h2{font-size:clamp(48px,11vw,128px)}
.join p{max-width:44ch;font-size:22px}
.join .btn{background:var(--paper);color:var(--ink);border-color:var(--paper)}
.join .btn:hover{background:transparent;color:var(--paper)}
footer{padding:22px 0 34px;background:var(--ink);color:var(--gray);font-size:15px}
@media (max-width:760px){.hero .row,.fm{grid-template-columns:1fr}.crew{grid-template-columns:repeat(2,minmax(0,1fr))}.steps li{grid-template-columns:48px 1fr}.steps li:before{font-size:40px}.door{max-width:320px}}
@media (max-width:460px){.crew{grid-template-columns:1fr}}
@media (prefers-reduced-motion:no-preference){.hero h1{animation:rise .9s cubic-bezier(.2,.7,.2,1) both}@keyframes rise{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}}
</style>
</head>
<body>
